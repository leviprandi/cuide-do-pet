generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pets      Pet[]
  expenses  Expense[]
}

model Pet {
  id          String   @id @default(uuid())
  name        String
  species     String
  breed       String?
  birthDate   DateTime?
  weightKg    Float?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  events      Event[]
}

model Event {
  id          String   @id @default(uuid())
  type        String
  description String
  occurredAt  DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  petId       String
  pet         Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
}

model Expense {
  id          String   @id @default(uuid())
  item        String
  category    String
  amount      Float
  quantity    Float?
  unit        String?
  pricePerKg  Float?
  purchasedAt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}